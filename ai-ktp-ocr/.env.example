# Copy this file to .env and fill in your key. Never commit .env itself.

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: swap models without touching code. Any vision-capable OpenRouter
# model slug works, e.g. google/gemini-2.0-flash-001, openai/gpt-4o,
# anthropic/claude-3.5-sonnet
MODEL_CLASSIFICATION=google/gemini-2.0-flash-001
MODEL_OCR=google/gemini-2.0-flash-001

# Optional
APP_SITE_URL=http://localhost:8501
APP_NAME=AI KTP Classifier & OCR
DB_PATH=data/database.db
REQUEST_TIMEOUT_SECONDS=60
